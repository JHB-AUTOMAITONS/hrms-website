# Production URL used for canonical links, sitemap entries and OG tags.
# Falls back to a placeholder in lib/site-config.ts if unset.
NEXT_PUBLIC_SITE_URL=https://hrms.work

# Optional: override the Google Apps Script Web App URL that /contact and
# /book-demo form submissions are forwarded to (defaults to the production
# "HRMS Leads" sheet endpoint, hardcoded in lib/actions/submit-lead.ts).
# Set this for a different environment, e.g. staging.
GOOGLE_APPS_SCRIPT_URL=

# Optional: override the GA4 measurement ID (defaults to the production
# property, G-LZKB2JYJ4G, hardcoded in components/analytics/GoogleAnalytics.tsx).
# Set this for a different environment, e.g. staging.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: override the Microsoft Clarity project ID (defaults to the
# production project, y68l6b9cd5, hardcoded in
# components/analytics/MicrosoftClarity.tsx). Set this for a different
# environment, e.g. staging.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
