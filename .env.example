# Production URL used for canonical links, sitemap entries and OG tags.
# Falls back to a placeholder in lib/site-config.ts if unset.
NEXT_PUBLIC_SITE_URL=https://www.manithamhrms.com

# Optional: where /contact and /book-demo form submissions are forwarded
# (CRM intake endpoint, serverless email function, etc). Submissions
# validate successfully but aren't delivered anywhere until this is set.
LEAD_WEBHOOK_URL=

# Optional: override the GA4 measurement ID (defaults to the production
# property, G-LZKB2JYJ4G, hardcoded in components/analytics/GoogleAnalytics.tsx).
# Set this for a different environment, e.g. staging.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
